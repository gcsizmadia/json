    <!--<PackageReadmeFile></PackageReadmeFile>-->
    <PackageTags>$(PackageTags) json systemtextjson System.Text.Json enum JsonStringEnumMemberNameAttribute EnumMemberAttribute DescriptionAttribute DisplayNameAttribute DisplayAttribute</PackageTags>
    <PackageReleaseNotes>Please visit https://github.com/gcsizmadia/json/releases to view the release notes.</PackageReleaseNotes>
